+namespace
+{
+// Griffin Amplification: the loop of Base::Process below with the degrees fixed at compile time, the
+// ring indices wrapped by a compare instead of %, and the history/coefficient vectors read through
+// plain pointers. Same operations in the same order, so the output is bit-identical; about 3x
+// faster for the biquads (degree 3/3) that every EQ and tone filter here uses.
+template <int InDeg, int OutDeg>
+void ProcessFixedDegree(DSP_SAMPLE* const* inputs, DSP_SAMPLE* const* outputs, const size_t numChannels,
+                        const size_t numFrames, const double* inCoef, const double* outCoef,
+                        std::vector<std::vector<DSP_SAMPLE>>& inHistory,
+                        std::vector<std::vector<DSP_SAMPLE>>& outHistory, long& inStart, long& outStart)
+{
+  long inputStart = 0, outputStart = 0; // As in Base::Process (also with no channels)
+  for (size_t c = 0; c < numChannels; c++)
+  {
+    inputStart = inStart;
+    outputStart = outStart;
+    DSP_SAMPLE* xh = inHistory[c].data();
+    DSP_SAMPLE* yh = outHistory[c].data();
+    const DSP_SAMPLE* in = inputs[c];
+    DSP_SAMPLE* out = outputs[c];
+    for (size_t s = 0; s < numFrames; s++)
+    {
+      DSP_SAMPLE y = 0.0;
+      if (--inputStart < 0)
+        inputStart = InDeg - 1;
+      xh[inputStart] = in[s];
+      for (int i = 0; i < InDeg; i++)
+      {
+        const long k = inputStart + i;
+        y += inCoef[i] * xh[k < InDeg ? k : k - InDeg];
+      }
+      if (--outputStart < 0)
+        outputStart = OutDeg - 1;
+      for (int i = 1; i < OutDeg; i++)
+      {
+        const long k = outputStart + i;
+        y += outCoef[i] * yh[k < OutDeg ? k : k - OutDeg];
+      }
+      if (std::isnan(y))
+        y = 0.0;
+      yh[outputStart] = y;
+      out[s] = y;
+    }
+  }
+  inStart = inputStart;
+  outStart = outputStart;
+}
+} // namespace
