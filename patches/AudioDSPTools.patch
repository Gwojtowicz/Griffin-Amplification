+static dsp::wav::LoadReturnCode _LoadInterleaved(const char* fileName, std::vector<float>& audio, double& sampleRate,
+                                                 int& numChannels);
+
+dsp::wav::LoadReturnCode dsp::wav::LoadChannels(const char* fileName, std::vector<std::vector<float>>& channels,
+                                                double& sampleRate)
+{
+  std::vector<float> interleaved;
+  int numChannels = 1;
+  const LoadReturnCode rc = _LoadInterleaved(fileName, interleaved, sampleRate, numChannels);
+  channels.clear();
+  if (rc != LoadReturnCode::SUCCESS)
+    return rc;
+  const size_t frames = interleaved.size() / (size_t)numChannels;
+  channels.assign((size_t)numChannels, std::vector<float>(frames));
+  for (size_t i = 0; i < frames; i++)
+    for (int c = 0; c < numChannels; c++)
+      channels[(size_t)c][i] = interleaved[i * (size_t)numChannels + (size_t)c];
+  return rc;
+}
+
 dsp::wav::LoadReturnCode dsp::wav::Load(const char* fileName, std::vector<float>& audio, double& sampleRate)
+{
+  int numChannels = 1;
+  const LoadReturnCode rc = _LoadInterleaved(fileName, audio, sampleRate, numChannels);
+  if (rc == LoadReturnCode::SUCCESS && numChannels > 1)
+  {
+    // The average of the channels (a stereo IR's two mics, blended).
+    const size_t frames = audio.size() / (size_t)numChannels;
+    for (size_t i = 0; i < frames; i++)
+    {
+      double sum = 0.0;
+      for (int c = 0; c < numChannels; c++)
+        sum += audio[i * (size_t)numChannels + (size_t)c];
+      audio[i] = (float)(sum / numChannels);
+    }
+    audio.resize(frames);
+  }
+  return rc;
+}
