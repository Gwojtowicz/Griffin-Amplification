+// its time packing the input block on every call.
+template <int T>
+inline void Sse8Accum(const float* W, const float* const (&x)[4], __m128 (&lo)[4], __m128 (&hi)[4])
+{
+  for (int j = 0; j < 8; j++)
+  {
+    const __m128 wl = _mm_loadu_ps(W + j * 8), wh = _mm_loadu_ps(W + j * 8 + 4);
+    for (int t = 0; t < T; t++)
