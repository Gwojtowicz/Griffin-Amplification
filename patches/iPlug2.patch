+  /** Griffin Amplification: draws single-line text so it fits `bounds`' width -- shrunk to as
+   * little as 70% of its size, then shortened in the middle with an ellipsis if it still doesn't fit. */
+  static void DrawTextFitted(IGraphics& g, const IText& text, const char* str, const IRECT& bounds, const IBlend* pBlend)
+  {
+    if (!str || !*str || strchr(str, '\n') || bounds.W() <= 2.f)
+    {
+      g.DrawText(text, str, bounds, pBlend);
+      return;
+    }
+    const float maxW = bounds.W() - 2.f;
+    IText fitted = text;
+    IRECT measured;
+    float w = g.MeasureText(fitted, str, measured);
+    // Shrink (text width isn't exactly proportional to size, so step down until it fits).
+    const float minSize = text.mSize * 0.7f;
+    if (w > maxW && w > 0.f)
+    {
+      fitted.mSize = std::max(minSize, text.mSize * maxW / w);
+      w = g.MeasureText(fitted, str, measured);
+      while (w > maxW && fitted.mSize > minSize)
+      {
+        fitted.mSize = std::max(minSize, fitted.mSize * 0.96f);
+        w = g.MeasureText(fitted, str, measured);
+      }
+    }
+    if (w <= maxW)
+    {
+      g.DrawText(fitted, str, bounds, pBlend);
+      return;
+    }
+    const std::string s(str);
+    std::string shortened = s;
+    for (size_t keep = s.size() - 1; keep >= 2; keep--)
+    {
+      const size_t head = (keep + 1) / 2, tail = keep / 2;
+      shortened = s.substr(0, head) + "..." + s.substr(s.size() - tail);
+      if (g.MeasureText(fitted, shortened.c_str(), measured) <= maxW)
+        break;
+    }
+    g.DrawText(fitted, shortened.c_str(), bounds, pBlend);
+  }
