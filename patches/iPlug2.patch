+  // GL's framebuffer rows count up from the bottom. A pixel of slack on each side.
+  const int fbH = MainFramePixels(WindowHeight(), GetScreenScale());
+  const int x0 = std::max(0, static_cast<int>(std::floor(bounds.L * scale)) - 1);
+  const int x1 = static_cast<int>(std::ceil(bounds.R * scale)) + 1;
+  const int y0 = std::max(0, fbH - static_cast<int>(std::ceil(bounds.B * scale)) - 1);
+  const int y1 = fbH - static_cast<int>(std::floor(bounds.T * scale)) + 1;
+  mRegionScissor[0] = x0;
+  mRegionScissor[1] = y0;
+  mRegionScissor[2] = std::max(0, x1 - x0);
+  mRegionScissor[3] = std::max(0, y1 - y0);
+  _ApplyRegionScissor(true);
+  nvgBindFramebuffer(mMainFrameBuffer);
+  BeginMainNVGFrame(mVG, WindowWidth(), WindowHeight(), GetScreenScale());
+#endif
