+void IPlugAPPHost::OpenPreferencesDialog()
+{
+  // Posted, not sent: the dialog is modal, and the caller may be inside a UI callback.
+  if (gHWND)
+    PostMessage(gHWND, WM_COMMAND, ID_PREFERENCES, 0);
+}
+
+bool IPlugAPPHost::RestartAudioIfDriverAsked()
+{
+  bool restart = RtApiAsioConsumeResetRequest();
+  if (mState.mAudioDriverType != kDeviceASIO || !mDAC || !mDAC->isStreamOpen())
+    return false;
+  // Some drivers don't ask for a reset when the size is changed in their panel: watch the
+  // size they prefer instead.
+  long minSize, maxSize, preferSize, granularity;
+  if (ASIOGetBufferSize(&minSize, &maxSize, &preferSize, &granularity) == ASE_OK)
+  {
+    if (mDriverPreferredBufferSize > 0 && preferSize != mDriverPreferredBufferSize)
+      restart = true;
+    mDriverPreferredBufferSize = preferSize;
+  }
+  if (!restart)
+    return false;
+  // Adopt the size now set in the driver's own panel: asked for 0, RtAudio opens with the driver's
+  // preferred size. Otherwise a driver that accepts any size would just get the old one again.
+  mState.mBufferSize = 0;
+  TryToChangeAudio();
+  if (mBufferSize > 0)
+  {
+    mState.mBufferSize = mBufferSize;
+    mActiveState.mBufferSize = mBufferSize;
+    UpdateINI();
+  }
+  return true;
+}
+#endif
