+// Griffin local edit (1.32.2): the main frame buffer and the GL viewport are whole device pixels
+// (WindowWidth() * screen scale, truncated), so NanoVG gets the view size that matches them exactly.
+// Passing WindowWidth() itself made one logical unit slightly less than screenScale device pixels
+// whenever that product wasn't whole (a 663-unit-tall window at 2.5x is 1657.5 px; the buffer is
+// 1657). Every pixel-aligned clip edge then fell mid-pixel, and NanoVG's anti-aliased scissor let
+// the controls under an opaque full-window page bleed through as faint lines along the edges of the
+// regions being redrawn.
+static int MainFramePixels(int windowSize, float screenScale)
+{
+  return static_cast<int>(static_cast<float>(windowSize) * screenScale);
+}
+
+static float MainFrameViewSize(int windowSize, float screenScale)
+{
+  return static_cast<float>(MainFramePixels(windowSize, screenScale)) / screenScale;
+}
+
+static void BeginMainNVGFrame(NVGcontext* pContext, int windowWidth, int windowHeight, float screenScale)
+{
+  nvgBeginFrame(pContext, MainFrameViewSize(windowWidth, screenScale), MainFrameViewSize(windowHeight, screenScale),
+                screenScale);
+}
